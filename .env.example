# Copy this file to .env and fill in real values.
# Never commit .env — it is listed in .gitignore.

# --- Vision AI provider(s) ---
# Only the provider(s) actually implemented/tested need to be set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4

# --- Request behavior ---
VISION_REQUEST_TIMEOUT_SECONDS=30
VISION_MAX_RETRIES=1

# --- Paths (defaults shown; override if needed) ---
SCREENSHOT_RAW_DIR=screenshots/raw
SCREENSHOT_ANNOTATED_DIR=screenshots/annotated
RESULTS_RAW_DIR=results/raw
RESULTS_REPORTS_DIR=results/reports
