# Copy this file to .env and fill in real values.
# Never commit .env — it is listed in .gitignore.

# --- Vision provider selection (2026-09-05, Claude-primary/Gemini-fallback) ---
# PRIMARY_VISION_PROVIDER is the provider used for every Vision call.
# FALLBACK_VISION_PROVIDER, if set to a DIFFERENT provider than the
# primary, is used ONLY when the primary technically fails (timeout,
# network error, rate limit, 5xx, malformed/unparseable response) after
# its own retry budget (PROVIDER_RETRY_COUNT) is exhausted — never for a
# semantic/safety disagreement (e.g. "no target email found" always
# safe-stops, it never triggers a second provider's opinion). Leave
# FALLBACK_VISION_PROVIDER unset (or equal to PRIMARY_VISION_PROVIDER)
# to disable fallback entirely.
PRIMARY_VISION_PROVIDER=anthropic
FALLBACK_VISION_PROVIDER=gemini

# Legacy single-provider selector — still fully supported. Used ONLY
# when PRIMARY_VISION_PROVIDER is unset, so existing .env files that
# predate the fallback architecture keep behaving exactly as before
# (single provider, zero fallback). Ignored once PRIMARY_VISION_PROVIDER
# is set.
AI_PROVIDER=anthropic

# --- Vision AI provider credentials ---
# Only the provider(s) actually selected above (primary and/or
# fallback) need real values — an unselected provider's key is never
# even read.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4

# --- Request behavior ---
VISION_REQUEST_TIMEOUT_SECONDS=30
VISION_MAX_RETRIES=1

# --- Paths (defaults shown; override if needed) ---
SCREENSHOT_RAW_DIR=screenshots/raw
SCREENSHOT_ANNOTATED_DIR=screenshots/annotated
RESULTS_RAW_DIR=results/raw
RESULTS_REPORTS_DIR=results/reports
