# Environment / secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# R&D data (may contain local screen content — see docs on screenshot handling)
screenshots/raw/*
screenshots/annotated/*
!screenshots/raw/.gitkeep
!screenshots/annotated/.gitkeep
results/raw/*
results/reports/*
!results/raw/.gitkeep
!results/reports/.gitkeep

# Runtime-generated debug overlays and benchmark output (historical ones
# already committed stay in git history; only NEW local runs are ignored
# going forward — same convention as screenshots/raw and results/raw above)
debug/*
!debug/.gitkeep
benchmarks/results/*
!benchmarks/results/.gitkeep

# Editors
.vscode/
.idea/
